    "sig": "essay_browse_catalog(text)",
    "definition": "CREATE OR REPLACE FUNCTION public.essay_browse_catalog(p_university text)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n with catalog(source_id,db_id,name) as (values\n('gachon','a9e38cdc-9593-4c60-b8a6-698133f48518','가천대학교'),\n('catholic','c5850ef5-616e-4ebb-aeac-3f6a3e7c4d0a','가톨릭대학교'),\n('kangnam',null,'강남대학교'),\n('konkuk','77fe30b2-f693-4612-a6d3-50e8be5c8f6c','건국대학교'),\n('kyonggi','295f71b3-12da-4122-b743-f0c2c8bebe44','경기대학교'),\n('knu','72bc4be0-6e72-4c72-adc5-8ee54279f3bd','경북대학교'),\n('kyunghee','b401cc24-dd17-575e-8ac6-0fd8c9c8405d','경희대학교'),\n('korea','a93ec9df-2096-4550-801f-07a25b9a437b','고려대학교'),\n('kwangwoon','3d35489f-2e90-47b8-af1b-48928ee2269a','광운대학교'),\n('kookmin','88aa2231-6a1c-47ee-a063-b168cdaf85ad','국민대학교'),\n('dankook','bdae801b-e46e-449f-9211-0a440f8eb78d','단국대학교'),\n('duksung',null,'덕성여자대학교'),\n('dongguk','cd1ba908-2b5f-4063-a111-2da53d7d358b','동국대학교'),\n('dongduk',null,'동덕여자대학교'),\n('pnu','08303fd3-ec87-4976-a9a9-547a1d52f996','부산대학교'),\n('syu',null,'삼육대학교'),\n('sangmyung',null,'상명대학교'),\n('sogang','816c1cb8-b54d-4f05-ae64-e82abfec0ada','서강대학교'),\n('seokyeong',null,'서경대학교'),\n('seoultech','52ec1dd2-b27b-4a5e-9ebb-a85cb8079ff2','서울과학기술대학교'),\n('uos','0598e08a-20d6-4814-9511-6abe22814355','서울시립대학교'),\n('swu',null,'서울여자대학교'),\n('skku','4acee829-94d4-5f8a-b440-a72e423d439f','성균관대학교'),\n('sungshin',null,'성신여자대학교'),\n('sejong','447d2f79-fb0a-4a02-bce6-d214244b683d','세종대학교'),\n('suwon',null,'수원대학교'),\n('sookmyung','c4fa65ac-bbc6-5897-b4d8-f12f5a8f222b','숙명여자대학교'),\n('soongsil','6ae1fd3f-22da-43f4-a796-1cfe960c5fcb','숭실대학교'),\n('shinhan',null,'신한대학교'),\n('ajou','25f8c2a3-7a6c-445a-80c5-f62f7b1ca4c6','아주대학교'),\n('yonsei','9076637b-d827-5bb6-8e4e-954bd2a05805','연세대학교'),\n('eulji',null,'을지대학교'),\n('ewha','fdc7e693-15a2-47fc-b080-4f14e9274d95','이화여자대학교'),\n('inha','e40f4b8f-8949-4726-a774-2b6f0e6d8939','인하대학교'),\n('cau','ffad67a6-107f-47b7-a1cb-ab61687ffb9f','중앙대학교'),\n('tukorea',null,'한국공학대학교'),\n('koreatech',null,'한국기술교육대학교'),\n('hufs','1fd29b0d-1141-4ff0-b1b3-c4f201854476','한국외국어대학교'),\n('kau',null,'한국항공대학교'),\n('hanshin',null,'한신대학교'),\n('hanyang','1090e1be-174e-5042-abd3-ca929c6e26f8','한양대학교'),\n('hongik','15f50d54-001d-49b9-836b-a5d9c76b9c0a','홍익대학교')\n ), selected as (\n select u.id from public.universities u join catalog c\n on (c.db_id is not null and u.id=c.db_id::uuid)\n or (c.db_id is null and u.slug=c.source_id and u.name=c.name)\n where c.source_id=p_university\n ), exams as (\n select e.id,e.university_id,e.admission_year,e.exam_kind,coalesce(e.field_or_division,e.admission_track) admission_track,e.exam_name,\n (select jsonb_agg(jsonb_build_object('id',q.id,'label',q.label) order by q.display_order,q.id)\n from public.essay_questions q where q.essay_exam_id=e.id) questions\n from public.essay_exams e join selected s on s.id=e.university_id\n where e.id <> all(array['c435f96e-0ce0-5603-ac22-c0984662eb98'::uuid,'a68fa7e1-b701-5c7b-95ae-cfc46850614f'::uuid,'eb9c551a-dd29-5454-9a55-8b58a2bb432d'::uuid,'cb4dc5d6-df44-519d-82b4-64833a13304e'::uuid,'de78b082-d9b1-5234-8bb9-d7f7543294db'::uuid,'1a3a3532-8fa1-5d33-917c-e99d441e1788'::uuid,'18902739-69fc-53c8-a9a7-6bf620c9008b'::uuid,'a2a9d777-2237-50c2-af89-a617b88c5bff'::uuid,'5ebc33d1-1097-5ed4-b521-6b9a25d13eaf'::uuid,'3368bb8c-eaf7-5c8f-9e50-aa86c3eb36a1'::uuid,'d2abfee2-2412-5630-9af8-a858116b6759'::uuid,'baceb638-55ee-5d78-8ff4-93dad7832914'::uuid,'10ade245-4c6a-552b-beae-5dc7af3b75bd'::uuid,'b1e3505a-359e-5122-bf42-32b1cb49a174'::uuid,'1705c7d2-e11d-570f-9a4a-d220d0600acd'::uuid,'91802b60-96bf-5cb6-abef-d1c1a738ae6f'::uuid,'44eba80d-09ed-5e8c-a988-01e90c78ffd4'::uuid,'45febe31-1b94-5648-a081-e335f82e81a4'::uuid,'1e66b782-4e74-5fd4-b36d-032991875522'::uuid,'6f01f238-622d-5a85-9a04-8bb5a7b9759d'::uuid,'65c60943-796e-59d0-a3e6-12a43411356b'::uuid,'52a6cbdf-dc7b-5b03-b42f-ec24d88adcb3'::uuid,'e172d96f-0567-560d-8b80-63660e655a9a'::uuid,'f2807bf1-7ffb-51b1-b062-41e7feb6f3a4'::uuid,'afc6578e-a531-5719-8706-b57f53921998'::uuid,'39493cde-f3ca-558d-9aab-7d3c5d7b871a'::uuid,'452155b0-b752-5dca-8912-49b37a5c6bef'::uuid,'423a09b8-b89e-578e-9744-e3c96d0dd611'::uuid,'3ebbbb28-afad-514d-a294-a50fabbdd917'::uuid,'5a565963-98db-5f0f-a7b0-5c879f4eaedb'::uuid,'55b45df4-d873-5c4b-9dcb-6741c0197298'::uuid,'06379378-b27e-510d-8027-abef96a08564'::uuid,'49fd76ae-48d9-5f33-a7f9-3873203847d1'::uuid,'6db119ec-58bd-5d5c-83ab-af33d192ffcc'::uuid,'b462a69f-b52d-5b81-b934-3157e4eb9e7f'::uuid,'4c582db3-d518-57f9-b3b1-56c257aca2e5'::uuid,'bb865f39-f41b-57a3-91b9-e96d2cb86478'::uuid,'4de2b4ff-7ce4-57f4-a864-14627899cdf9'::uuid,'4eb4266c-f109-540a-880b-4044730b4474'::uuid,'d01c91a0-2867-5f20-9df3-2eecc94cc329'::uuid,'6bc75b10-b63f-52cd-b74f-44ddacfb90e9'::uuid,'9e3bf5ce-eeeb-51e2-abad-addf41ad1973'::uuid,'47c0b9ff-5d09-5bb9-a1d2-052f87e9803a'::uuid,'78dc85f3-f3c8-5c8b-98fc-ff96b87527ac'::uuid,'6aa5f389-5cf0-5a35-84e7-ba74bb13557f'::uuid,'f1f86385-3ee4-5af4-a836-e819bae455a6'::uuid,'4835da12-452e-57c3-b134-9dbea8f821bb'::uuid,'dcbe742e-c418-5081-ad06-44953ec2ffac'::uuid,'6be424d3-ffc6-56ed-bab5-5d86416d142e'::uuid,'11ac8d4a-c8e4-5184-ac2a-8d622722cdcf'::uuid])\n )\n select coalesce(jsonb_agg(jsonb_build_object(\n 'examId',id,'universityId',university_id,'year',admission_year,\n 'kind',exam_kind,'track',admission_track,'title',exam_name,\n 'questionCount',jsonb_array_length(questions),'questions',questions,\n 'evaluationReady',false) order by admission_year desc,exam_name,id)\n filter(where questions is not null),'[]'::jsonb) from exams;\n$function$\n",
    "acl": "{postgres=X/postgres,anon=X/postgres,authenticated=X/postgres}"
  },
  {
    "sig": "math_private.release_catalog(uuid)",
    "definition": "CREATE OR REPLACE FUNCTION math_private.release_catalog(p_exam uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare result jsonb;begin\n select coalesce(jsonb_agg(x),'[]') into result from (\n select s.essay_exam_id,q.id as essay_question_id,l.id as leaf_id,l.statement,p.statement as problem_statement,s.label||' · '||q.label as label,l.response_format\n from public.math_subproblems l join public.math_problems p on p.id=l.problem_id join public.math_problem_sets s on s.id=p.problem_set_id\n join public.essay_questions q on q.id=case when l.id='3bab07d3-c047-53c2-89ad-9fa20ec7b3f3'::uuid then 'cea40cf3-dc05-507a-a6eb-fd5e1e1847bb'::uuid else l.essay_question_id end and q.essay_exam_id=s.essay_exam_id\n where l.id=any(array['018b6b54-4815-504a-adb8-685faa204516'::uuid,'06cd2ae1-c7a5-52cb-8ab9-2725bbc7af9f'::uuid,'085d88cf-f279-56b6-a559-4c62679e60cf'::uuid,'0afcc1e0-68ed-56f1-94ef-52d4d81f144b'::uuid,'110e8736-854d-59a0-b4e6-7036a559b83a'::uuid,'11b0d01b-c247-54a5-88b5-368440f68c6f'::uuid,'148cb335-4931-52c1-8270-a1bac78c7082'::uuid,'1699c649-dcf0-5024-84f3-4775eaed49c3'::uuid,'169e0ff4-4fd3-5f87-9908-a8cbe7e768ce'::uuid,'1b28617b-36c6-5dd8-9879-48cb53466814'::uuid,'1cd8b541-a44c-513c-9afe-39cd46664a69'::uuid,'1ffa56cf-7b97-592b-a48c-8ab19e1e29f0'::uuid,'201f3df4-4851-52a3-9e18-6209ef34b56c'::uuid,'206c7e42-f324-5d92-8bbe-b11979d57eda'::uuid,'20fb9238-14bb-5100-949f-66dba3f08ccc'::uuid,'2186939f-a84c-535e-bd6b-647713856dbe'::uuid,'24f4aa41-fdc1-5801-ac60-fe7b1c4ded0c'::uuid,'2514e9c3-77ae-5f98-9eca-16de25ef1f5d'::uuid,'2b528dc2-5c4e-5e4f-8ecb-8bb4c2a4d8e1'::uuid,'2c34ec6b-5821-56df-b07c-99d5f365eca4'::uuid,'2c34f7fb-1485-5030-9b71-b2bd72fd6403'::uuid,'2c405a4c-6a94-530d-be82-76ecf8158138'::uuid,'2ce0c120-41de-538e-aed7-376b7efc5f3b'::uuid,'301f18a3-73b7-5552-a960-6235ff53b1fc'::uuid,'31a6ae05-81d5-5026-907b-85f75f2bec6d'::uuid,'31df8d5d-a638-50dd-b6f1-4b3ed6da4610'::uuid