{
  "name": "legendstudy-lab-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "LegendStudy LAB — static Next.js App Router foundation",
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "audit:github-ready": "node scripts/audit-github-ready.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:boundaries && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "client-only": "^0.0.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  }
}
